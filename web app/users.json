{
  "ui": [
    {
      "type": "sidebar",
      "color": "#3827F5",
      "items": [
        {
          "icon": "home",
          "label": "Dashboard",
          "onclick": {
            "1": {
              "type": "navigation",
              "app_id": "cc9P8gZ",
              "view_id": "Home_Dash"
            }
          }
        },
        {
          "icon": "user",
          "label": "Customer",
          "onclick": {
            "1": {
              "type": "navigation",
              "app_id": "cc9P8gZ",
              "view_id": "users"
            }
          }
        }
      ]
    },
    {
      "type": "grouped_counter_1",
      "cards": [
        {
          "icon": "users",
          "text": "{{users_grouping.data.[0].total_customers}}",
          "color": "#F7FAFC",
          "label": "Total Customers",
          "font_size": 16,
          "icon_color": "#805AD5",
          "font_weight": "bold"
        },
        {
          "icon": "smile",
          "text": "{{users_grouping.data.[0].active_customers}}",
          "color": "#F0FFF4",
          "label": "active",
          "font_size": 16,
          "icon_color": "#38A169",
          "font_weight": "bold"
        },
        {
          "icon": "frown",
          "text": "{{users_grouping.data.[0].inactive_customers}}",
          "color": "#FFFBEB",
          "label": "inactive",
          "font_size": 16,
          "icon_color": "#F59E0B",
          "font_weight": "bold"
        },
        {
          "icon": "meh",
          "text": "{{users_grouping.data.[0].hold_customers}}",
          "color": "#FEF2F2",
          "label": "On Hold",
          "font_size": 16,
          "icon_color": "#EF4444",
          "font_weight": "bold"
        }
      ],
      "title": "Customer Summary",
      "width": 7,
      "columns": 4,
      "element_id": "Customer_Summary",
      "isBackground": true,
      "element_count": 4,
      "customAspectRatio": 2
    },
    {
      "type": "gutter"
    },
    {
      "ui": [
        {
          "data": "user_list.data",
          "type": "table",
          "title": "ser_activity",
          "width": 12,
          "actions": [
            {
              "icon": "eye",
              "text": "View",
              "type": "button",
              "color": "#3B82F6",
              "title": "View customer details",
              "onclick": {
                "1": {
                  "type": "navigation",
                  "app_id": "cc9P8gZ",
                  "view_id": "view_customer_view",
                  "arguments": {
                    "customer_city": "{{rowData.customer_city}}",
                    "customer_name": "{{rowData.customer_name}}"
                  },
                  "navigation_type": "view"
                }
              },
              "btn_type": "filled_button",
              "font_size": 14,
              "icon_size": 16,
              "text_color": "#FFFFFF",
              "font_weight": "500",
              "background_color": "#3B82F6"
            },
            {
              "icon": "edit",
              "text": "edit",
              "type": "button",
              "color": "#F59E0B",
              "title": "Edit customer information",
              "onclick": {
                "1": {
                  "type": "navigation",
                  "app_id": "cc9P8gZ",
                  "view_id": "edit_customer_view",
                  "arguments": {
                    "customer_city": "{{arguments.rowData.city}}",
                    "customer_name": "{{arguments.rowData.customer_name}}"
                  },
                  "navigation_type": "view"
                }
              },
              "btn_type": "icon_button",
              "text_color": "#F59E0B",
              "background_color": "#FEF3C7"
            }
          ],
          "columns": [
            {
              "type": "text",
              "field": "customer_name",
              "title": "Name",
              "width": 300,
              "readOnly": true
            },
            {
              "type": "custom",
              "field": "status",
              "title": "Status",
              "width": 250,
              "renderer": [
                {
                  "type": "container",
                  "child": {
                    "text": "{{status}}",
                    "type": "text",
                    "color_key": "status",
                    "color_map": {
                      "hold": "EF4555",
                      "active": "#10B981",
                      "inactive": "#EF4444"
                    },
                    "font_size": 12,
                    "font_weight": "600"
                  },
                  "padding": {
                    "vertical": 4,
                    "horizontal": 12
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "age",
              "title": "Age",
              "width": 250,
              "readOnly": true
            },
            {
              "type": "text",
              "field": "city",
              "title": "City",
              "width": 300,
              "readOnly": true
            }
          ],
          "pageSize": 10,
          "element_id": "user_activity_table",
          "show_search": true,
          "stripe_rows": true,
          "border_radius": 8,
          "row_hover_color": "#F9FAFB",
          "show_pagination": true,
          "header_text_color": "#374151",
          "header_background_color": "#FFFFFF"
        }
      ],
      "type": "container_with_title",
      "title": "User Activity Count",
      "width": 12,
      "actions": [
        {
          "icon": "upload",
          "btn_type": "icon_button"
        },
        {
          "icon": "download",
          "btn_type": "icon_button"
        }
      ],
      "element_id": "user_activity_container",
      "show_title": true,
      "title_color": "#1F2937",
      "element_count": 2,
      "title_font_size": 16,
      "title_font_weight": "600"
    }
  ],
  "data": {
    "user_list": "select customer_name, status, city, age ,phone_number from ajay_customer",
    "users_grouping": "SELECT COALESCE(COUNT(*), 0) as total_customers, COALESCE(SUM(CASE WHEN a.status = 'active' THEN 1 ELSE 0 END), 0) as active_customers, COALESCE(SUM(CASE WHEN a.status = 'inactive' THEN 1 ELSE 0 END), 0) as inactive_customers,COALESCE(SUM(CASE WHEN a.status = 'hold' THEN 1 ELSE 0 END), 0) as hold_customers  FROM  ajay_customer a"
  },
  "label": "customer_summary",
  "margin": {
    "top": 24,
    "left": 24,
    "right": 24,
    "bottom": 24
  },
  "view_id": "users"
}